# Copy this file to .env for local development.

# Runtime environment used by application safety checks.
SAB_ENVIRONMENT=development

# PostgreSQL persistence and Redis-backed asynchronous task messaging.
SAB_DATABASE_URL=postgresql+psycopg://sab:sab@localhost:5432/sab
SAB_REDIS_URL=redis://localhost:6379/0

# Disposable PostgreSQL database used by integration tests.
SAB_TEST_DATABASE_URL=postgresql+psycopg://sab:sab@localhost:5432/sab_test

# Log rendering for API, worker, and scheduler processes.
SAB_LOG_FORMAT=console

# Source and UTC schedule for authorization synchronization.
SAB_AUTHORIZATION_SOURCE_REPOSITORY=geneontology/go-site
SAB_AUTHORIZATION_SOURCE_REF=master
SAB_AUTHORIZATION_SOURCE_PATH=metadata/users.yaml
SAB_AUTHORIZATION_SYNC_CRON=0 0 * * *

# Allowlisted ontology source registry and UTC load schedule. Each nested ontology
# entry must include its complete source configuration.
SAB_ONTOLOGY_SOURCES__GO__SOURCE_TYPE=github
SAB_ONTOLOGY_SOURCES__GO__REPOSITORY=geneontology/go-ontology
SAB_ONTOLOGY_SOURCES__GO__REF=master
SAB_ONTOLOGY_SOURCES__GO__PATH=src/ontology/go-edit.obo
SAB_ONTOLOGY_LOAD_CRON=0 2 * * 1,3,5

# GitHub sign-in and request signing for internal token management.
SAB_APPLICATION_SECRET=replace-with-a-local-development-secret
SAB_GITHUB_OAUTH_CLIENT_ID=
SAB_GITHUB_OAUTH_CLIENT_SECRET=
SAB_GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
