# Copy this file to .env for local development.

# Runtime environment used by application safety checks.
SABE_ENVIRONMENT=development

# PostgreSQL persistence and Redis-backed asynchronous task messaging.
SABE_DATABASE_URL=postgresql+psycopg://sabe:sabe@localhost:5432/sabe
SABE_REDIS_URL=redis://localhost:6379/0

# Disposable PostgreSQL database used by integration tests.
SABE_TEST_DATABASE_URL=postgresql+psycopg://sabe:sabe@localhost:5432/sabe_test

# Log rendering for API, worker, and scheduler processes.
SABE_LOG_FORMAT=console

# Reference data sources (config/sources.yaml), retrieval timeouts, and UTC refresh
# schedules.
SABE_SOURCES_FILE=config/sources.yaml
SABE_SOURCE_CONNECT_TIMEOUT_SECONDS=10
SABE_SOURCE_READ_TIMEOUT_SECONDS=60
SABE_AUTHORIZATION_REFRESH_CRON="0 0 * * *"
SABE_ONTOLOGY_REFRESH_CRON="0 2 * * 1,3,5"
SABE_ENTITY_REFRESH_CRON="0 3 * * *"
SABE_ANNOTATION_REFRESH_CRON="0 4 * * *"

# GitHub sign-in and request signing for internal token management.
SABE_APPLICATION_SECRET=replace-with-a-local-development-secret
SABE_GITHUB_OAUTH_CLIENT_ID=
SABE_GITHUB_OAUTH_CLIENT_SECRET=
SABE_GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
