# Copy this file to .env for local development.
SAB_DATABASE_URL=postgresql+psycopg://sab:sab@localhost:5432/sab
SAB_TEST_DATABASE_URL=postgresql+psycopg://sab:sab@localhost:5432/sab_test
SAB_REDIS_URL=redis://localhost:6379/0
SAB_APPLICATION_SECRET=replace-with-a-local-development-secret
SAB_ENVIRONMENT=development
SAB_LOG_FORMAT=console
# Configure a GitHub OAuth app when exercising the internal token-management routes.
SAB_GITHUB_OAUTH_CLIENT_ID=
SAB_GITHUB_OAUTH_CLIENT_SECRET=
SAB_GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
